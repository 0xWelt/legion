#!/usr/bin/env bash
# ============================================================================
# Legion CLI — unified entry point
# ============================================================================
# Usage: legion <command> [args...]
#
# Thin dispatcher that routes commands to the appropriate handler:
#   - gateway subcommands  → scripts/legion-gateway
#   - setup/config/agent   → node dist/bootstrap.js
#
# For development (no build needed), use:
#   npm run dev             → tsx src/bootstrap.ts (runs gateway)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

usage() {
  cat <<EOF
Legion — Coding Agent IM Bridge

Usage: legion <command> [args...]

Commands:
  setup                 First-time config wizard
  gateway <action>      Manage the gateway service
    run                   Run in foreground
    install               Install as systemd service
    uninstall             Uninstall the service
    start                 Start the service
    stop                  Stop the service
    restart               Restart the service
    status                Show service status
  config <action>       Manage configuration
    show                  Display current config
  agent <action>        Manage coding agents
    list                  List available agents
  --version             Show version
  --help                Show this help

Examples:
  legion gateway run      Run gateway in foreground (production mode)
  legion gateway install  Install and enable systemd service
  legion gateway start    Start the background service
  legion setup            First-time configuration wizard

For development with hot-reload (no build needed):
  npm run dev
EOF
  exit 0
}

cmd="${1:-}"

case "$cmd" in
  --help|-h|"")
    usage
    ;;
  --version|-v)
    node -e "console.log(require('$PROJECT_DIR/package.json').version)"
    ;;
  gateway)
    shift
    exec "$SCRIPT_DIR/legion-gateway" "$@"
    ;;
  setup|config|agent|state)
    exec node "$PROJECT_DIR/packages/legion/dist/bootstrap.js" "$@"
    ;;
  *)
    echo "Unknown command: $cmd"
    echo "Run 'legion --help' for usage."
    exit 1
    ;;
esac
