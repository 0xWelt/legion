{
  "name": "legion-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge layer between coding agents and IM platforms",
  "keywords": [
    "claude-code",
    "coding-agent",
    "discord",
    "im-bridge",
    "kimi-code"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "changeset": "changeset",
    "dev": "tsx packages/legion/src/bootstrap.ts",
    "prepare": "vp config",
    "publish-packages": "vp run -r build && vp exec changeset publish",
    "start": "node packages/legion/dist/bootstrap.mjs",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.28.0",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vite-plus": "^0.2.4",
    "vitest": "^4.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20.20.2"
  },
  "packageManager": "pnpm@11.11.0"
}
