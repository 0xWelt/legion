{
  "name": "legion-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge layer between coding agents and IM platforms",
  "keywords": [
    "claude-code",
    "coding-agent",
    "discord",
    "im-bridge",
    "kimi-code"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "changeset": "changeset",
    "dev": "tsx watch --watch-path=packages packages/legion/src/bootstrap.ts",
    "dev:webui": "concurrently -k -n backend,frontend \"tsx watch --watch-path=packages packages/legion/src/bootstrap.ts\" \"pnpm --filter @0xwelt/legion-webui dev\"",
    "prepare": "vp config",
    "publish-packages": "vp run -r build && cd packages/legion && npm publish --dry-run && cd ../.. && vp exec changeset publish",
    "start": "node packages/legion/dist/bootstrap.mjs",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.28.0",
    "@types/node": "^22.13.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vite-plus": "^0.2.4",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.20.2"
  },
  "packageManager": "pnpm@11.17.0"
}
