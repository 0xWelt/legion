    "dev": "tsx packages/legion/src/bootstrap.ts",
    "start": "node packages/legion/dist/bootstrap.mjs",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vite-plus": "^0.2.4",
    "vitest": "^4.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0",
      "onFail": "download"
    }
