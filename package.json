{
  "name": "legion-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge layer between coding agents and IM platforms",
  "keywords": [
    "claude-code",
    "coding-agent",
    "discord",
    "im-bridge",
    "kimi-code"
  ],
  "license": "MIT",
  "author": "",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
