{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./packages/legion/src",
    "outDir": "./packages/legion/dist",
    "paths": {
      "@0xwelt/legion-api": ["./packages/legion-api/src/index.ts"],
      "@0xwelt/legion": ["./packages/legion/src/index.ts"],
      "@0xwelt/legion-kimi-code": ["./packages/legion-kimi-code/src/index.ts"],
      "@0xwelt/legion-discord": ["./packages/legion-discord/src/index.ts"],
      "@0xwelt/legion-lark": ["./packages/legion-lark/src/index.ts"]
    }
  },
  "include": ["packages/legion/src/bootstrap.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "./packages/legion-api" },
    { "path": "./packages/legion" },
    { "path": "./packages/legion-kimi-code" },
    { "path": "./packages/legion-discord" },
    { "path": "./packages/legion-lark" }
  ]
}
